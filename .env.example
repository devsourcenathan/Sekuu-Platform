APP_NAME="Sekuu Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Base de données
# ---------------------------------------------------------------------------
# La plateforme utilise une base PostgreSQL unique, partagée par tous les
# modules. Chaque module y est propriétaire exclusif de ses tables.
# @see docs/01-overview/architecture.md

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=sekuu_platform
DB_USERNAME=sekuu
DB_PASSWORD=sekuu

# ---------------------------------------------------------------------------
# Identity — signature des access tokens
# ---------------------------------------------------------------------------
#
# En local, laisser vide : `php artisan identity:generate-keys` ecrit la paire
# dans storage/app/private/identity/, et cela suffit.
#
# ### EN PRODUCTION, PASSER LES CLES PAR CES VARIABLES ###
#
#   php artisan identity:generate-keys --show
#
# `--show` les affiche au lieu de les ecrire. C'est ce qu'il faut : un
# deploiement par releases successives remplace storage/, les fichiers
# disparaissent, une nouvelle paire est generee — et **tous les tokens en
# circulation deviennent invalides d'un coup**. Tous les utilisateurs
# deconnectes, sans explication et sans moyen de revenir en arriere.
#
# Les passer par l'environnement rend ce scenario impossible.

IDENTITY_JWT_PRIVATE_KEY=
IDENTITY_JWT_PUBLIC_KEY=

# Identifie l'emetteur dans le token. A aligner sur le domaine reel.
IDENTITY_JWT_ISSUER=

# ---------------------------------------------------------------------------
# Sous-domaines des modules
# ---------------------------------------------------------------------------
# Laisser vide en local : les routes des modules répondent alors sur
# n'importe quel hôte, sans configuration DNS.
# En production : SEKUU_DOMAIN_IDENTITY=identity.sekuu.com
# @see config/sekuu.php

SEKUU_DOMAIN_IDENTITY=
SEKUU_DOMAIN_VERIFY=
SEKUU_DOMAIN_NOTIFY=
SEKUU_DOMAIN_BILLING=
SEKUU_DOMAIN_PAYMENTS=
SEKUU_DOMAIN_STORAGE=
SEKUU_DOMAIN_AI=
SEKUU_DOMAIN_SEARCH=
SEKUU_DOMAIN_ANALYTICS=

# La plateforme est une API : l'authentification est un JWT, sans etat serveur.
# Aucune session n'est necessaire, et `database` exigerait une table `sessions`
# qu'aucune migration ne cree — seule la route web de courtoisie la
# declencherait, en erreur 500.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ---------------------------------------------------------------------------
# Files et cache
# ---------------------------------------------------------------------------
# `compose.yaml` fournit Redis en developpement : `docker compose up -d`.
#
# La file n'est pas un confort. Elle porte les envois de Notify **et les
# webhooks sortants de Payments** : sans worker qui tourne, un produit externe
# n'apprend jamais ses encaissements autrement qu'en sondant.
#
# `database` fonctionne sans Redis, au prix d'une latence et d'une charge en
# ecriture. Acceptable en developpement, jamais en production.

QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# L'envoi réel des messages relève du module Notify, pas d'Identity.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@sekuu.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Notify — fournisseurs
# ---------------------------------------------------------------------------
# SMS : la passerelle locale est le fournisseur de premier rang. Sur les
# marchés visés, un acheminement local est moins cher et mieux délivré qu'un
# envoi international, qui ne sert que de bascule.

SMS_GATEWAY_ENDPOINT=
SMS_GATEWAY_TOKEN=
SMS_GATEWAY_SENDER_ID=SEKUU
SMS_GATEWAY_WEBHOOK_SECRET=

# Plafond de depense mensuel par organisation, en NOTIFY_LIMIT_CURRENCY.
# Vide = aucun controle : une boucle ou une cle fuitee ne serait alors arretee
# par rien avant le releve du fournisseur.
NOTIFY_LIMIT_CURRENCY=XAF
NOTIFY_SMS_MONTHLY_COST=
NOTIFY_WHATSAPP_MONTHLY_COST=

TWILIO_ACCOUNT_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# Email : Resend est le fournisseur retenu. Sans RESEND_API_KEY il est ignoré
# et le mailer Laravel prend la main — pratique en développement, mais aucun
# rebond ne remonte alors, et la liste de suppression ne s'alimente pas.
#
# Le domaine de RESEND_FROM doit être vérifié chez Resend (DKIM + Return-Path),
# sinon les messages partent non signés et finissent en spam.
RESEND_API_KEY=
RESEND_FROM="Sekuu <no-reply@sekuu.com>"

# Sans ce secret, le webhook Resend est fermé — jamais ouvert.
RESEND_WEBHOOK_SECRET=

# Postmark reste disponible en bascule. Laisser vide pour ne pas l'utiliser.
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM=
POSTMARK_WEBHOOK_TOKEN=

# --------------------------------------------------------------------------
# Payments
# --------------------------------------------------------------------------
#
# Les paiements passent par des agregateurs Mobile Money. Sans identifiants,
# aucun agregateur n'est essaye : le module le dit franchement plutot que
# d'echouer a l'execution. `GET /api/v1/payments/health` repond alors
# can_collect=false.
#
# ###  L'ENVIRONNEMENT ET LES IDENTIFIANTS DOIVENT ETRE D'ACCORD  ###
#
# `CredentialGuard` echoue des qu'un agregateur est resolu si ce n'est pas le
# cas, dans les deux sens, et il n'existe aucune option pour l'ignorer.
# `GET /api/v1/payments/health` est la verification d'avant-vol :
#
#   APP_ENV != production  ->  cle Notch Pay prefixee `test_`, Tranzak sandbox
#   APP_ENV  = production  ->  cle Notch Pay reelle,          Tranzak dsapi
#
# Le sens le plus dangereux est le premier. **Notch Pay ne distingue pas ses
# environnements par l'URL** : `api.notchpay.co` sert les deux, et seul le
# prefixe de la cle decide. Une cle de production sur un poste de
# developpement fait sonner le telephone d'une vraie personne, et la debite.
#
# Le sens inverse se voit encore moins : une cle de test en production ouvre
# des services sans rien encaisser, et personne ne le signale.
#
# Tranzak est le premier ecrit des trois : il est le seul a documenter un bac
# a sable et un endpoint de rafraichissement de statut.
TRANZAK_BASE_URL=https://sandbox.dsapi.tranzak.me
TRANZAK_APP_ID=
TRANZAK_APP_KEY=

# `authKey` des callbacks : un secret partage transporte dans le corps, pas
# une signature. Il prouve que l'emetteur connait le secret, jamais que le
# corps est intact — c'est pourquoi le statut est toujours relu chez Tranzak
# plutot que pris dans le callback.
#
# Sans ce secret, aucun callback n'est accepte : une variable oubliee ne doit
# pas devenir une porte ouverte sur les paiements.
TRANZAK_AUTH_KEY=

# XAF, devise **sans centime** : 45 000 XAF se stocke 45000, jamais 4500000.
BILLING_CURRENCY=XAF

# Determine le taux de TVA applique et fige a l'emission (CM : 19,25 %).
BILLING_COUNTRY=CM

BILLING_QUEUE=billing

# Notch Pay — premier rang de priorite (ADR-0008). Sans NOTCHPAY_PUBLIC_KEY il
# n'est jamais essaye, et Tranzak prend la main.
#
# `Authorization` porte la cle **publique**, sans prefixe Bearer. Une cle de
# test est prefixee `test_`.
NOTCHPAY_BASE_URL=https://api.notchpay.co
NOTCHPAY_PUBLIC_KEY=

# `X-Grant` : exige sur les soldes et les transferts uniquement. Les paiements
# n'en ont pas besoin — renseigne pour le jour ou le module decaissera.
NOTCHPAY_PRIVATE_KEY=

# Signature des callbacks : HMAC-SHA256 sur le corps brut, en-tete
# `x-notch-signature`. Une vraie signature, contrairement au secret partage de
# Tranzak. Sans elle, aucun callback n'est accepte.
NOTCHPAY_WEBHOOK_HASH=

# URL de rappel par paiement. Vide = celle du tableau de bord. Utile quand un
# seul compte marchand sert plusieurs environnements : le tableau de bord
# n'accepte qu'une URL.
NOTCHPAY_CALLBACK_URL=
